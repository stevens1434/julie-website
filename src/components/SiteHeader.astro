---
import { navLinks, siteMeta, withBase } from "../data/site";

const normalizedBase = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const rawPath = Astro.url.pathname || "/";
const currentPath = normalizedBase && rawPath.startsWith(normalizedBase) ? rawPath.slice(normalizedBase.length) || "/" : rawPath;
---

<header class="site-header">
  <div class="shell shell--wide header-inner">
    <a class="brand-lockup" href={withBase("/")}>
      <span class="brand-eyebrow">DNP-FNP Candidate</span>
      <span class="brand-name">{siteMeta.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {navLinks.map((item) => {
          const isActive = currentPath === item.href;

          return (
            <li>
              <a href={withBase(item.href)} aria-current={isActive ? "page" : undefined} class:list={{ "is-active": isActive }}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
