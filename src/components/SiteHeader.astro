---
import { navLinks, siteMeta, withBase } from "../data/site";

const normalizedBase = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const rawPath = Astro.url.pathname || "/";
const currentPath = normalizedBase && rawPath.startsWith(normalizedBase) ? rawPath.slice(normalizedBase.length) || "/" : rawPath;
---

<header class="site-header">
  <div class="shell shell--wide header-inner">
    <a class="brand-lockup" href={withBase("/")}>
      <span class="brand-eyebrow">DNP-FNP Candidate</span>
      <span class="brand-name">{siteMeta.name}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Open navigation menu"
      data-nav-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="primary-navigation" aria-label="Primary" data-nav-menu>
      <ul class="nav-list">
        {navLinks.map((item) => {
          const isActive = currentPath === item.href;

          return (
            <li>
              <a href={withBase(item.href)} aria-current={isActive ? "page" : undefined} class:list={{ "is-active": isActive }}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector(".site-header");
    const toggle = header?.querySelector("[data-nav-toggle]");
    const menu = header?.querySelector("[data-nav-menu]");

    if (!header || !toggle || !menu) return;

    const closeMenu = () => {
      header.dataset.menuOpen = "false";
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open navigation menu");
    };

    const openMenu = () => {
      header.dataset.menuOpen = "true";
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close navigation menu");
    };

    const isDesktop = () => window.innerWidth > 760;

    toggle.addEventListener("click", () => {
      if (header.dataset.menuOpen === "true") {
        closeMenu();
      } else {
        openMenu();
      }
    });

    document.addEventListener("click", (event) => {
      if (isDesktop() || header.dataset.menuOpen !== "true") return;
      if (!header.contains(event.target)) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (!isDesktop()) closeMenu();
      });
    });

    window.addEventListener("resize", () => {
      if (isDesktop()) closeMenu();
    });

    closeMenu();
  })();
</script>
