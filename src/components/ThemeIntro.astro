  </section>

  <section class="cinema-intro__experience cinema-intro__experience--retro" data-intro-experience="retro" hidden aria-hidden="true">
    <div class="retro-intro">
      <div class="retro-intro__screen">
        <div class="retro-intro__brand">
          <div class="retro-intro__brand-mark" aria-hidden="true">
            <span></span>
          </div>
          <div class="retro-intro__brand-copy">
            <small>AMERICA</small>
            <strong>Online</strong>
          </div>
        </div>

        <div class="retro-intro__panels">
          <div class="retro-intro__panel">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="25" r="16" fill="#ffd157" stroke="#1e2340" stroke-width="5" />
              <path d="M43 52C52 40 72 40 78 55L94 86" fill="none" stroke="#ffd157" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M46 62L26 84" fill="none" stroke="#ffd157" stroke-width="15" stroke-linecap="round" />
              <path d="M58 85L82 98" fill="none" stroke="#ffd157" stroke-width="15" stroke-linecap="round" />
            </svg>
          </div>
          <div class="retro-intro__panel retro-intro__panel--motion">
            <svg viewBox="0 0 160 120" aria-hidden="true">
              <g transform="translate(18 0)">
                <circle cx="60" cy="25" r="16" fill="#ffd157" stroke="#1e2340" stroke-width="5" />
                <path d="M43 52C52 40 72 40 78 55L94 86" fill="none" stroke="#ffd157" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M46 62L26 84" fill="none" stroke="#ffd157" stroke-width="15" stroke-linecap="round" />
                <path d="M58 85L82 98" fill="none" stroke="#ffd157" stroke-width="15" stroke-linecap="round" />
              </g>
              <path d="M12 34H48" stroke="#1e2340" stroke-width="6" stroke-linecap="round" />
              <path d="M6 58H42" stroke="#1e2340" stroke-width="6" stroke-linecap="round" />
              <path d="M14 82H50" stroke="#1e2340" stroke-width="6" stroke-linecap="round" />
            </svg>
          </div>
          <div class="retro-intro__panel retro-intro__panel--connected">
            <div class="retro-intro__connected-mark" aria-hidden="true">
              <div class="retro-intro__connected-triangle"></div>
              <div class="retro-intro__connected-orb"></div>
              <div class="retro-intro__connected-splash"></div>
            </div>
          </div>
        </div>

        <p class="retro-intro__status retro-intro__status--dialing">Dialing...</p>
        <p class="retro-intro__status retro-intro__status--connected">Connected!</p>
        <div class="retro-intro__divider" aria-hidden="true"></div>
      </div>

      <div class="cinema-intro__disclaimer cinema-intro__disclaimer--retro">
        <p class="cinema-intro__disclaimer-label">Parody-Inspired Homage</p>
        <p>{disclaimerText}</p>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (() => {
    const themeStore = window.__JULIE_THEME__;
    const intro = document.querySelector("[data-cinema-intro]");

    if (!themeStore || !intro) return;

    const durations = {
      retro: 7800,
      starwars: 36000,
      jurassic: 15000
    };
    const reducedDurations = {
      retro: 3400,
      starwars: 7600,
      jurassic: 4600
    };
    const cinematicThemes = new Set(["retro", "starwars", "jurassic"]);
    const experiences = Array.from(intro.querySelectorAll("[data-intro-experience]"));
    const closeButtons = intro.querySelectorAll("[data-intro-skip], [data-intro-close]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let closeTimer = null;

    const setExperience = (theme) => {
      experiences.forEach((experience) => {
        const experienceTheme = experience.getAttribute("data-intro-experience");
        const isActive = experienceTheme === theme;
        experience.hidden = !isActive;
        experience.setAttribute("aria-hidden", isActive ? "false" : "true");
      });
    };

    const clearCloseTimer = () => {
      if (!closeTimer) return;
      window.clearTimeout(closeTimer);
      closeTimer = null;
    };

    const closeIntro = (immediate = false) => {
      clearCloseTimer();

      if (immediate) {
        intro.hidden = true;
        intro.dataset.state = "closed";
        intro.setAttribute("aria-hidden", "true");
        return;
      }

      intro.dataset.state = "closing";
      window.setTimeout(() => {
        intro.hidden = true;
        intro.dataset.state = "closed";
        intro.setAttribute("aria-hidden", "true");
      }, 260);
    };

    const openIntro = (theme) => {
      clearCloseTimer();
      setExperience(theme);
      intro.dataset.theme = theme;
      intro.dataset.motion = reducedMotion.matches ? "reduced" : "full";
      intro.hidden = false;
      intro.setAttribute("aria-hidden", "false");
      intro.dataset.state = "opening";

      requestAnimationFrame(() => {
        intro.dataset.state = "open";
      });

      closeTimer = window.setTimeout(
        () => closeIntro(false),
        reducedMotion.matches ? reducedDurations[theme] || 2400 : durations[theme] || 10000
      );
    };

    const shouldReplay = (detail) =>
      Boolean(
        detail &&
          detail.__meta?.reason === "theme-toggle" &&
          cinematicThemes.has(detail.creativeTheme) &&
          detail.__previous?.creativeTheme !== detail.creativeTheme
      );

    closeButtons.forEach((button) => {
      button.addEventListener("click", () => closeIntro(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && intro.dataset.state === "open") {
        closeIntro(false);
      }
    });

    window.addEventListener("julie-theme-change", (event) => {
      const detail = event.detail;
      if (!detail) return;

      if (shouldReplay(detail)) {
        openIntro(detail.creativeTheme);
        return;
      }

      if (!cinematicThemes.has(detail.creativeTheme)) {
        closeIntro(true);
      }
    });
  })();
</script>
