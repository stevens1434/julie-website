            <rect x="864" y="368" width="282" height="38" fill="#59351b" />
            <rect x="864" y="420" width="282" height="38" fill="#59351b" />
            <rect x="864" y="472" width="282" height="38" fill="#59351b" />
            <rect x="864" y="524" width="282" height="68" fill="#59351b" />
