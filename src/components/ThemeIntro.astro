          <path d="M34 900C90 816 126 704 132 596C176 704 208 780 278 850C220 836 192 846 176 900H34Z" fill="url(#jurassicLeaf)" opacity="0.92" />
          <path d="M1368 900C1416 810 1454 700 1468 590C1510 696 1542 772 1606 838C1554 834 1526 846 1508 900H1368Z" fill="url(#jurassicLeaf)" />
          <path d="M1254 900C1316 838 1354 762 1374 682C1406 758 1440 818 1492 856C1436 842 1404 852 1382 900H1254Z" fill="url(#jurassicLeaf)" opacity="0.92" />
