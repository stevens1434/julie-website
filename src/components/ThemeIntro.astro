---
import "../styles/theme-intros-immersive.css";

const disclaimerText =
  "This experience is a parody-inspired homage to the original. It is not affiliated with, endorsed by, or sponsored by the original creators or rights holders. It is presented for commentary and entertainment purposes only.";
---

<div class="cinema-intro" data-cinema-intro hidden aria-hidden="true" data-state="closed" data-theme="standard">
  <div class="cinema-intro__scrim" data-intro-close></div>
  <button class="cinema-intro__skip" type="button" data-intro-skip>Skip intro</button>

  <section class="cinema-intro__experience cinema-intro__experience--starwars" data-intro-experience="starwars" hidden aria-hidden="true">
    <div class="starwars-intro">
      <div class="starwars-intro__space" aria-hidden="true"></div>

      <div class="starwars-intro__prelude">
        A long time ago in a healthcare system not so far away....
      </div>

      <div class="starwars-intro__logo" aria-hidden="true">
        <span>JULIE</span>
        <span>STEVENS</span>
      </div>

      <div class="starwars-intro__crawl-stage">
        <div class="starwars-intro__crawl">
          <p class="starwars-intro__episode">Episode FNP</p>
          <h2 class="starwars-intro__title">THE PORTFOLIO AWAKENS</h2>
          <p>
            It is a period of clinical transition. After years of high-acuity bedside service, Julie Stevens prepares to move
            from critical care and specialty nursing into family nurse practitioner practice.
          </p>
          <p>
            Carrying experience forged in pediatric nephrology, cardiac intensive care, PICU, travel nursing, and community-based
            advanced practice training, she now advances toward a broader mission of prevention, continuity, and equitable care.
          </p>
          <p>
            Employers who enter this portfolio will discover leadership, scholarship, and clinical depth assembled into one
            hiring-ready dossier, prepared for the next frontier in family-centered practice.
          </p>
        </div>
      </div>

      <div class="cinema-intro__disclaimer cinema-intro__disclaimer--starwars">
        <p class="cinema-intro__disclaimer-label">Parody-Inspired Homage</p>
        <p>{disclaimerText}</p>
      </div>
    </div>
  </section>

  <section class="cinema-intro__experience cinema-intro__experience--jurassic" data-intro-experience="jurassic" hidden aria-hidden="true">
    <div class="jurassic-intro">
      <svg class="jurassic-intro__art" viewBox="0 0 1600 900" aria-hidden="true">
        <defs>
          <linearGradient id="jurassicSky" x1="800" y1="0" x2="800" y2="900" gradientUnits="userSpaceOnUse">
            <stop stop-color="#05070b" />
            <stop offset="0.44" stop-color="#102018" />
            <stop offset="1" stop-color="#1d2413" />
          </linearGradient>
          <radialGradient id="jurassicMoonGlow" cx="0.5" cy="0.18" r="0.48">
            <stop stop-color="#fff5c0" stop-opacity="0.28" />
            <stop offset="0.55" stop-color="#fff5c0" stop-opacity="0.06" />
            <stop offset="1" stop-color="#fff5c0" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="jurassicRoad" x1="800" y1="396" x2="800" y2="900" gradientUnits="userSpaceOnUse">
            <stop stop-color="#6d6258" />
            <stop offset="0.3" stop-color="#433930" />
            <stop offset="1" stop-color="#130d0b" />
          </linearGradient>
          <linearGradient id="jurassicStone" x1="0" y1="0" x2="1" y2="1">
            <stop stop-color="#7f674d" />
            <stop offset="0.4" stop-color="#58412c" />
            <stop offset="1" stop-color="#26170d" />
          </linearGradient>
          <linearGradient id="jurassicWood" x1="0" y1="0" x2="1" y2="1">
            <stop stop-color="#7b4822" />
            <stop offset="0.45" stop-color="#4f2d16" />
            <stop offset="1" stop-color="#24130a" />
          </linearGradient>
          <linearGradient id="jurassicMetal" x1="0" y1="0" x2="1" y2="1">
            <stop stop-color="#e0b56d" />
            <stop offset="0.54" stop-color="#a36028" />
            <stop offset="1" stop-color="#5c3011" />
          </linearGradient>
          <linearGradient id="jurassicJeep" x1="0" y1="0" x2="1" y2="1">
            <stop stop-color="#cb4421" />
            <stop offset="0.55" stop-color="#b52814" />
            <stop offset="1" stop-color="#4c130c" />
          </linearGradient>
          <linearGradient id="jurassicGlass" x1="0" y1="0" x2="1" y2="1">
            <stop stop-color="#d7f4ff" />
            <stop offset="1" stop-color="#7ab0c8" />
          </linearGradient>
          <linearGradient id="jurassicFlame" x1="0" y1="0" x2="0" y2="1">
            <stop stop-color="#fff6bd" />
            <stop offset="0.38" stop-color="#ffb85a" />
            <stop offset="1" stop-color="#b33d12" />
          </linearGradient>
          <linearGradient id="jurassicLeaf" x1="0" y1="0" x2="1" y2="1">
            <stop stop-color="#2d5425" />
            <stop offset="0.52" stop-color="#173017" />
            <stop offset="1" stop-color="#0d170d" />
          </linearGradient>
          <filter id="jurassicTexture" x="-10%" y="-10%" width="120%" height="120%">
            <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="2" seed="4" result="noise" />
            <feColorMatrix
              in="noise"
              type="matrix"
              values="0 0 0 0 0.36  0 0 0 0 0.25  0 0 0 0 0.18  0 0 0 0.24 0"
              result="grain"
            />
            <feBlend in="SourceGraphic" in2="grain" mode="multiply" />
          </filter>
          <filter id="jurassicGlow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="18" />
          </filter>
          <filter id="jurassicHeadlights" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="12" />
          </filter>
          <filter id="jurassicShadow" x="-30%" y="-30%" width="160%" height="160%">
            <feDropShadow dx="0" dy="12" stdDeviation="18" flood-color="#000000" flood-opacity="0.45" />
          </filter>
        </defs>

